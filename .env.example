# .env.example
DATABASE_URL=postgres://scheduler:scheduler@localhost:5432/scheduler
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production
SUPER_ADMIN_JWT_SECRET=change-me-super-admin-secret

# Super admin seed credentials
SUPER_ADMIN_EMAIL=admin@scheduler.internal
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_PASSWORD=change-me-seed-password

# Email (Resend) — https://resend.com
RESEND_API_KEY=re_COLOQUE_SUA_CHAVE_AQUI
RESEND_FROM_EMAIL=noreply@scheduler.app
FRONTEND_BASE_DOMAIN=scheduler.app

# OAuth SSO providers
# Google: https://console.cloud.google.com → Credentials → OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft: https://portal.azure.com → App registrations → Redirect URIs
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Facebook: https://developers.facebook.com → App → Facebook Login → Settings
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# URL base pública da API (usada como redirect_uri nos providers OAuth)
# Redirect URI para cada provider: {OAUTH_CALLBACK_BASE_URL}/auth/oauth/{provider}/callback
OAUTH_CALLBACK_BASE_URL=http://localhost:3001

# Chave de criptografia para secrets SSO armazenados no banco (AES-256-GCM)
# Gere com: openssl rand -hex 32
ENCRYPTION_KEY=
