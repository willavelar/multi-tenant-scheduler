# ─── API environment (packages/api) ──────────────────────────────────────────
# Copy this file to `.env` and fill in real values:
#   cp packages/api/.env.example packages/api/.env
# This file is loaded when running the API outside Docker (pnpm dev:api).

# ── Database & cache (required) ──
# When running the API on the host, point to localhost.
# Inside Docker Compose the host names are `db` and `redis`.
DATABASE_URL=postgres://scheduler:scheduler@localhost:5432/scheduler
REDIS_URL=redis://localhost:6379

# ── JWT secrets (required) — use long, random strings ──
# Generate each one with: openssl rand -hex 32
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production
SUPER_ADMIN_JWT_SECRET=change-me-super-admin-secret

# ── Encryption key (required) — AES-256-GCM for SSO secrets stored in the DB ──
# Must be 32 bytes hex. Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# ── Email (Resend) — required for invites / password resets ──
# Get an API key at https://resend.com
RESEND_API_KEY=re_your_key_here
RESEND_FROM_EMAIL=noreply@scheduler.app

# ── Frontend / OAuth base URLs (required) ──
# Base domain used to build links in emails and OAuth redirects (e.g. lvh.me:3000).
FRONTEND_BASE_DOMAIN=localhost:3000
# Public base URL of this API; OAuth redirect URI is
# {OAUTH_CALLBACK_BASE_URL}/auth/oauth/{provider}/callback
OAUTH_CALLBACK_BASE_URL=http://localhost:3001

# ── Super-admin seed credentials (required to run db:seed) ──
SUPER_ADMIN_EMAIL=admin@scheduler.internal
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_PASSWORD=change-me-seed-password

# ── OAuth SSO providers (optional) ──
# Google: https://console.cloud.google.com → Credentials → OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── WhatsApp via Twilio (optional) ──
# If any of these is missing, WhatsApp sending is skipped (no error thrown).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
