# ─── Web environment (packages/web) ──────────────────────────────────────────
# Copy this file to `.env` and adjust as needed:
#   cp packages/web/.env.example packages/web/.env
#
# NOTE: NEXT_PUBLIC_* values are baked into the bundle at BUILD time. Changing
# them at runtime has no effect — rebuild the web app/image after editing.

# Base URL of the API. For local dev the default below is used automatically.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Application name shown in the UI.
NEXT_PUBLIC_APP_NAME=Scheduler
